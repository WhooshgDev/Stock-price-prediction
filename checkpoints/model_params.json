{
  "model": "TemporalFusionTransformer",
  "checkpoint": "tft-epoch=05-val_loss=0.0070.ckpt",
  "description": "Best run — return target, FP16, batch_size=256",

  "architecture": {
    "hidden_size": 128,
    "lstm_layers": 2,
    "attention_heads": 4,
    "dropout": 0.30,
    "hidden_continuous_sizes": {},
    "output_size": 7
  },

  "training": {
    "max_epochs": 50,
    "batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 1e-5,
    "loss": "QuantileLoss",
    "quantiles": [0.1, 0.25, 0.5, 0.6, 0.7, 0.75, 0.9],
    "gradient_clip_val": 0.1,
    "reduced_cg_overflow": true,
    "mask_bias": -1e4,
    "optimizer": "AdamW",
    "lr_scheduler": "ReduceLROnPlateau"
  },

  "data": {
    "target": "ret",
    "encoder_length": 60,
    "prediction_length": 5,
    "features": ["Open", "High", "Low", "Close", "Volume",
      "log_ret_1d", "log_ret_5d", "log_ret_21d", "log_ret_63d",
      "volatility", "volume_ma_ratio", "excess_return", "relative_volume",
      "ret_1d", "ret_5d", "ret_21d", "ret_63d"],
    "num_tickers": 61,
    "time_varying_unknown_reals": 19,
    "static_categoricals": ["ticker_id"]
  },

  "validation_metrics": {
    "MAE": 0.0122,
    "RMSE": 0.0196,
    "Directional_Accuracy": 64.85
  }
}
